<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <p class="eyebrow"><%= fmt.today() %> · <%= tz.replace(/_/g, ' ') %></p>
    <h1><%= fmt.greeting() %>, <%= user.name.split(' ')[0] %></h1>
  </div>
</div>

<% if (!courses.length) { %>
  <p class="empty">You are not enrolled in any active courses yet. Once your enrollments are confirmed, your work, timetable and grades will appear here.</p>
<% } else { %>
<section class="tiles" aria-label="At a glance">
  <div class="tile">
    <p class="tile-label">Due this week</p>
    <p class="tile-value"><%= thisWeek.length %></p>
    <% if (thisWeek[0]) { const n = thisWeek[0]; const urgent = Date.parse(n.due_at) - Date.now() < 48 * 3600e3; %>
      <p class="tile-note <%= urgent ? 'urgent' : '' %>">Next: <a href="/courses/<%= n.course_id %>/assignments/<%= n.id %>"><%= n.title %></a> · <%= fmt.rel(n.due_at) %></p>
    <% } else { %><p class="tile-note">Nothing due in the next 7 days</p><% } %>
  </div>
  <div class="tile <%= pastDue.length ? 'warn' : '' %>">
    <p class="tile-label">Past due</p>
    <p class="tile-value"><%= pastDue.length %></p>
    <% if (pastDue.length) { %>
      <p class="tile-note"><a href="<%= pastDue.length === 1 ? `/courses/${pastDue[0].course_id}/assignments/${pastDue[0].id}` : '/assignments?status=missing' %>"><%= pastDue.length === 1 ? pastDue[0].title : 'Review past-due work' %></a></p>
    <% } else { %><p class="tile-note">You’re all caught up</p><% } %>
  </div>
  <div class="tile">
    <p class="tile-label">Next class</p>
    <% if (next) { %>
      <p class="tile-value sm"><%= fmt.weekday(next.start) %> <%= fmt.time(next.start) %></p>
      <p class="tile-note"><%= next.course.code %> <%= next.title %> · <%= next.location %><% if (next.changed) { %> <span class="badge warn">Room changed</span><% } %></p>
    <% } else { %>
      <p class="tile-value sm">None soon</p><p class="tile-note">No classes in the next two weeks</p>
    <% } %>
  </div>
  <div class="tile">
    <p class="tile-label">New feedback</p>
    <p class="tile-value"><%= recentlyGraded.length %></p>
    <p class="tile-note"><% if (recentlyGraded.length) { %><a href="/courses/<%= recentlyGraded[0].course_id %>/assignments/<%= recentlyGraded[0].id %>#feedback"><%= recentlyGraded[0].title %></a><%= recentlyGraded.length > 1 ? ` and ${recentlyGraded.length - 1} more` : '' %><% } else { %>Nothing new this week<% } %></p>
  </div>
</section>

<div class="dash">
  <div>
    <%- include('../partials/due-card') %>
    <p id="due-live" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <div class="stack">
    <section class="card" aria-labelledby="grades-h">
      <header><h2 id="grades-h">Grades</h2><a href="/grades" class="small">All grades</a></header>
      <% for (const s of snapshot) { %>
        <div class="grade-row" style="--course: <%= s.course.color %>">
          <div class="kv">
            <a href="/courses/<%= s.course.id %>/grades" class="course-chip" style="--course: <%= s.course.color %>"><%= s.course.code %><span class="visually-hidden"> grades</span></a>
            <% if (s.total) { %>
              <span class="small"><span class="score"><%= s.total.percent.toFixed(1) %>%</span> <span class="muted">provisional</span></span>
            <% } else { %>
              <span class="small muted"><%= s.course.show_total ? 'No grades yet' : 'Total not shown' %></span>
            <% } %>
          </div>
          <% if (s.total) { %><div class="bar" aria-hidden="true"><i style="width: <%= Math.min(100, s.total.percent).toFixed(1) %>%"></i></div><% } %>
          <div class="small muted" style="<%= s.total ? '' : 'margin-top:.35rem' %>">
            <% if (s.latest) { %>Latest: <a href="/courses/<%= s.course.id %>/assignments/<%= s.latest.id %>#feedback"><%= s.latest.title %></a> — <%= s.latest.state.grade.excused ? 'Excused' : `${fmt.points(s.latest.state.grade.points)}/${fmt.points(s.latest.points)}` %>
            <% } else { %>No grades released yet<% } %>
          </div>
        </div>
      <% } %>
    </section>

    <section class="card" aria-labelledby="updates-h">
      <h2 id="updates-h">Recent updates</h2>
      <% if (!updates.length) { %>
        <p class="empty">No new announcements, materials or feedback in the last three weeks.</p>
      <% } else { %>
        <ul class="list">
          <% for (const u of updates) { %>
            <li>
              <span class="update-kind"><span aria-hidden="true"><%= u.icon %></span> <%= u.kind %> · <%= u.course.code %></span>
              <a class="item-title" href="<%= u.link %>"><%= u.title %></a>
              <span class="small muted"><%= fmt.rel(u.when) %></span>
            </li>
          <% } %>
        </ul>
      <% } %>
    </section>
  </div>
</div>
<% } %>
<%- include('../partials/foot') %>
