<%- include('../partials/head') %>
<h1>Courses &amp; terms</h1>
<div class="table-wrap" style="margin-bottom:1rem">
  <table><caption class="visually-hidden">Courses</caption>
    <thead><tr><th scope="col">Course</th><th scope="col">Term</th><th scope="col">Instructors</th><th scope="col" class="num">Students</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
    <tbody>
      <% for (const c of courses) { %>
        <tr>
          <th scope="row" style="font-weight:400"><%- include('../partials/course-chip', { c }) %> <%= c.title %></th>
          <td><%= c.term_name %></td><td class="small"><%= c.instructors || '—' %></td><td class="num"><%= c.students %></td>
          <td><span class="badge <%= c.status === 'active' ? 'ok' : 'outline' %>"><%= c.status %></span></td>
          <td class="small"><a href="/admin/courses/<%= c.id %>">Enrollments<span class="visually-hidden"> for <%= c.code %></span></a> ·
            <form method="post" action="/admin/courses/<%= c.id %>/status" class="inline" data-confirm="<%= c.status === 'active' ? 'Archive' : 'Restore' %> <%= c.code %>?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="linklike" type="submit"><%= c.status === 'active' ? 'Archive' : 'Restore' %><span class="visually-hidden"> <%= c.code %></span></button></form></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<div class="grid grid-2">
  <form class="card" method="post" action="/admin/courses">
    <h2>Create course shell</h2>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field-row">
      <div class="field"><label for="code">Code</label><input id="code" type="text" name="code" required placeholder="BIO 110"></div>
      <div class="field"><label for="color">Accent colour</label><input id="color" type="color" name="color" value="#3559c7"></div>
    </div>
    <div class="field"><label for="title">Title</label><input id="title" type="text" name="title" required></div>
    <div class="field"><label for="term">Term</label><select id="term" name="term_id"><% for (const t of terms) { %><option value="<%= t.id %>"><%= t.name %></option><% } %></select></div>
    <button class="btn" type="submit">Create course</button>
  </form>
  <form class="card" method="post" action="/admin/terms">
    <h2>Create term</h2>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="tn">Name</label><input id="tn" type="text" name="name" required placeholder="Summer 2027"></div>
    <div class="field-row">
      <div class="field"><label for="ts">Starts</label><input id="ts" type="date" name="start_date" required></div>
      <div class="field"><label for="te">Ends</label><input id="te" type="date" name="end_date" required></div>
    </div>
    <button class="btn secondary" type="submit">Create term</button>
    <h3 style="margin-top:1rem">Existing terms</h3>
    <ul class="small"><% for (const t of terms) { %><li><%= t.name %>: <%= t.start_date %> – <%= t.end_date %></li><% } %></ul>
  </form>
</div>
<%- include('../partials/foot') %>
