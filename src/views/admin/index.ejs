<%- include('../partials/head') %>
<div class="page-head"><div><h1>Administration</h1><p>Accounts, course shells, enrollments and the audit log. Administrators cannot view grades or submissions, and there is no account impersonation.</p></div></div>
<section class="tiles" aria-label="At a glance">
  <div class="tile"><p class="tile-label">Students</p><p class="tile-value"><%= counts.students %></p></div>
  <div class="tile"><p class="tile-label">Instructors</p><p class="tile-value"><%= counts.instructors %></p></div>
  <div class="tile"><p class="tile-label">Active courses</p><p class="tile-value"><%= counts.courses %></p></div>
  <div class="tile"><p class="tile-label">Active enrollments</p><p class="tile-value"><%= counts.enrollments %></p></div>
</section>
<section class="card">
  <header><h2>Recent audit events</h2><a href="/admin/audit">Full audit log</a></header>
  <div class="table-wrap"><table><thead><tr><th>When</th><th>Who</th><th>Action</th><th>Record</th><th>Change</th></tr></thead>
    <tbody><% for (const e of recent) { %><%- include('../partials/audit-row', { e }) %><% } %></tbody></table></div>
</section>
<%- include('../partials/foot') %>
