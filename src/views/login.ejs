<%- include('partials/head') %>
<div class="login">
  <div class="login-aside">
    <span class="brand"><span class="brand-mark" aria-hidden="true">SL</span> Learning Portal</span>
    <p style="margin-top:auto;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#a5b4fc">Fall term</p>
    <h1 style="margin-top:0">Everything due, in one place.</h1>
    <p>Deadlines, timetable, materials and grades across all your courses — with group work credited to everyone in the group.</p>
  </div>
  <div class="login-main">
    <section class="card" aria-labelledby="signin-h">
      <h2 id="signin-h" style="font-size:1.5rem;font-weight:800">Sign in</h2>
      <p class="muted">Use your university email and password. Institutional single sign-on replaces this form in production.</p>
      <% if (error) { %><div class="error-summary" role="alert" tabindex="-1"><%= error %></div><% } %>
      <form method="post" action="/login">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" required value="<%= email %>">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn" type="submit" style="width:100%">Sign in</button>
      </form>
    </section>
    <% if (demo.length) { %>
    <section class="demo-accounts" aria-labelledby="demo-h">
      <h2 id="demo-h">Demo accounts</h2>
      <p class="muted small">Fictional people, prototype only. Every demo password is <strong>demo1234</strong>. Choose an account to sign in as it.</p>
      <ul>
        <% for (const d of demo) { %>
          <li>
            <form method="post" action="/login">
              <input type="hidden" name="email" value="<%= d.email %>">
              <input type="hidden" name="password" value="demo1234">
              <button class="btn secondary" type="submit">
                <span><strong><%= d.name %></strong> <span class="badge outline"><%= d.role %></span><br><span class="small muted"><%= d.email %></span></span>
              </button>
            </form>
          </li>
        <% } %>
      </ul>
    </section>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
